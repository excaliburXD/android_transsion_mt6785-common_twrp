# System Prop Properties

# Hardware & Platform
ro.mediatek.platform=MT6785
ro.hardware=mt6785
ro.hardware.egl=meow
ro.opengles.version=196610
ro.board.platform=mt6785

# A/B Support
ro.build.ab_update=true
ro.virtual_ab.enabled=true
ro.boot.dynamic_partitions=true

# Crypto FBE / FBEv2
fbe.metadata.wrappedkey=true
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.volume.options=::v2

# Beanpod Hardware
ro.hardware.kmsetkey=beanpod
ro.hardware.gatekeeper=beanpod

# Prefix Fstab
ro.postinstall.fstab.prefix=/system

# USB
ro.sys.usb.storage.type=mtp

# [FIX] Stock-compatible properties needed for normal boot
# These properties match the stock firmware's default.prop values.
# Without them, the system partition's init may fail or behave incorrectly
# because it expects certain properties to be set by the ramdisk.
ro.sf.lcd_density=480
ro.oem_unlock_supported=1
ro.zygote=zygote64_32
ro.bionic.arch=arm64
ro.bionic.cpu_variant=cortex-a53
ro.bionic.2nd_arch=arm
ro.bionic.2nd_cpu_variant=cortex-a53

# [FIX] Vendor RC path - stock uses /vendor/etc/init/hw/ for vendor init scripts
ro.vendor.rc=/vendor/etc/init/hw/