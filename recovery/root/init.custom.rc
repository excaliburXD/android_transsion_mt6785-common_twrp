on boot
# Added Manual Persist vendor system teei_daemon
    mkdir /mnt/vendor/persist
    mkdir /mnt/vendor 0755 system system
    mkdir /mnt/vendor/persist 0755 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist

on init

# Added Manual adbd debug
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs && property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

# Added Manual for keystore
service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc
    disabled
    seclabel u:r:recovery:s0
